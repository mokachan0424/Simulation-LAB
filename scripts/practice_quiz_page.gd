var mode := "unit"
var _built_size := Vector2.ZERO  # ★v31追加★
var _view_state := ""  # ★v31追加★ "question" / "result" / "mock" / "empty"
var unit_index := 0
var questions: Array = []
var current_index := 0
var score := 0
var answered := false
var choice_buttons: Array = []
var feedback_label: Label
var next_btn: Button
# ★v15追加★ 模擬問題の問題数と制限時間
var mock_count := 30
var time_left := 0.0
var timer_active := false
var timed_out := false
var time_label: Label
# ★v16追加★ 記述問題の入力欄
var answer_edit: LineEdit
var submit_btn: Button


func setup_quiz(new_mode: String, new_unit_index: int = -1) -> void:
	mode = new_mode
	unit_index = new_unit_index
	if is_inside_tree():
		_prepare_questions()
		_build_question()


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	if mode == "mock":
		_build_mock_select()
		return
	_prepare_questions()
	if mode == "mock_hard":
		_start_timer(50 * 60)  # ★v32変更★ テスト問題50問で50分
	if questions.is_empty():
		_build_empty_page()
	else:
		_build_question()



# ★v15追加★ 模擬問題の問題数を選ぶ画面 (30問 / 40問 / 50問)
func _build_mock_select() -> void:
	_view_state = "mock"
	_built_size = size
	_clear_all()
	_add_bg_and_title("模擬問題")
	var screen_size := size
	var info := Label.new()
	info.text = "何問に挑戦しますか？\n模擬問題には制限時間があります（1問につき1分）。\n問題数の2割が、入力して答える記述問題です（30問なら6問）。\n時間になると自動で終わります。"
	info.position = Vector2(0, 150)
	info.size = Vector2(screen_size.x, 110)
	info.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	info.add_theme_font_size_override("font_size", 20)
	info.add_theme_color_override("font_color", TEXT_COLOR)
	add_child(info)
	var counts := [30, 40, 50]
	var select_btn_w := 430.0
	for i in counts.size():
		var c: int = counts[i]
		var btn := _make_btn("%d問に挑戦する（制限時間 %d分）" % [c, c], Vector2((screen_size.x - select_btn_w) / 2.0, 300.0 + i * 84.0), Vector2(select_btn_w, 68), Color.WHITE, TEXT_COLOR)
		btn.pressed.connect(_start_mock.bind(c))
		add_child(btn)


func _start_mock(count: int) -> void:
	mock_count = count
	_prepare_questions()
	_start_timer(count * 60)
	_build_question()


# ★v15追加★ 制限時間 (模擬問題だけ)
func _start_timer(seconds: int) -> void:
	time_left = float(seconds)
	timer_active = true
	timed_out = false


func _process(delta: float) -> void:
	if not timer_active:
		return
	time_left -= delta
	if time_left <= 0.0:
		time_left = 0.0
		timer_active = false
		timed_out = true
		_build_result()
		return
	if is_instance_valid(time_label):
		time_label.text = _time_text()
		if time_left <= 60.0:
			time_label.add_theme_color_override("font_color", RED)


func _time_text() -> String:
	var total := int(ceil(time_left))
	return "⏱ 残り時間 %d:%02d" % [total / 60, total % 60]


func _add_time_label() -> void:
	time_label = Label.new()
	time_label.text = _time_text()
	var screen_w := size.x
	time_label.position = Vector2(maxf(8.0, screen_w - 320.0), 35)  # ★v27変更★
	time_label.size = Vector2(280, 45)
	time_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	time_label.add_theme_font_size_override("font_size", 22)
	time_label.add_theme_color_override("font_color", TEXT_COLOR)
	add_child(time_label)


func _prepare_questions() -> void:
	questions.clear()
	current_index = 0
	score = 0
	if mode == "unit":
		for q in QUESTIONS:
			if int(q["unit"]) == unit_index:
				questions.append(q)
		questions.shuffle() # ★v13★ 出題順を毎回ランダムにする
	elif mode == "review":
		var history := _load_history()
		var mistakes: Array = history.get("mistakes", [])
		var mistake_ids: Array = []
		for v in mistakes:
			mistake_ids.append(int(v))
		for q in QUESTIONS:
			if mistake_ids.has(int(q["id"])):
				questions.append(q)
		questions.shuffle() # ★v13★ 出題順を毎回ランダムにする
	elif mode == "sub":
		for q in QUESTIONS:
			if int(q["sub"]) == unit_index:
				questions.append(q)
		questions.shuffle() # ★v13★ 出題順を毎回ランダムにする
	elif mode == "easy":  # ★v30追加★ 単元の簡易問題
		for q in EASY_QUESTIONS:
			if int(q["unit"]) == unit_index:
				questions.append(q)
		questions.shuffle()
	elif mode == "input":  # ★v30追加★ 自分で書く問題 (全50問)
		var all_inputs: Array = INPUT_QUESTIONS.duplicate()
		all_inputs.shuffle()
		questions = all_inputs
	elif mode == "mock":
		var all: Array = QUESTIONS.duplicate()
		all.shuffle()
		while all.size() > mock_count - mock_count / 5:
			all.pop_back()
		var inputs: Array = INPUT_QUESTIONS.duplicate()
		inputs.shuffle()
		while inputs.size() > mock_count / 5:
			inputs.pop_back()
		all.append_array(inputs)
		all.shuffle()
		questions = all
	elif mode == "mock_hard":  # ★v32変更★ テスト問題は50問全部 (選択35＋記述15)
		var test_all: Array = HARD_QUESTIONS.duplicate()
		test_all.append_array(HARD_INPUT_QUESTIONS)
		test_all.shuffle()
		questions = test_all


func _mode_title() -> String:
	if mode == "unit":
		if unit_index >= 0 and unit_index < UNIT_NAMES.size():
			return UNIT_NAMES[unit_index]
		return "練習問題"
	if mode == "review":
		return "復習"
	if mode == "sub":
		if unit_index >= 0 and unit_index < SUB_TITLES.size():
			return UNIT_NAMES[SUB_UNIT[unit_index]] + "：" + SUB_TITLES[unit_index]
		return "練習問題"
	if mode == "easy":
		if unit_index >= 0 and unit_index < UNIT_NAMES.size():
			return "📗 簡易問題：" + UNIT_NAMES[unit_index]
		return "📗 簡易問題"
	if mode == "input":
		return "✏️ 自分で書く問題（50問）"
	if mode == "mock_hard":
		return "📝 テスト問題（高校受験・テスト対策）"  # ★v31変更★
	return "模擬問題（%d問）" % mock_count


# ★v31追加★ 画面サイズが変わったら、今の画面を作り直す（入力中のときは除く）
func _notification(what: int) -> void:
	if what == NOTIFICATION_RESIZED and _view_state != "":
		if size.distance_to(_built_size) > 4.0:
			match _view_state:
				"question":
					if not answered:
						_build_question()
				"result":
					_build_result()
				"mock":
					_build_mock_select()
				"empty":
					_build_empty_page()


func _clear_all() -> void:
	for child in get_children():
		remove_child(child)
		child.queue_free()
	choice_buttons.clear()


func _build_empty_page() -> void:
	_view_state = "empty"
	_built_size = size
	_clear_all()
	_add_bg_and_title("復習")
	var label := Label.new()
	label.text = "復習待ちの問題はありません。\nまずは単元の問題を解いてみよう！"
	label.position = Vector2(0, 260)
	label.size = Vector2(size.x, 80)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", 20)
	label.add_theme_color_override("font_color", TEXT_COLOR)
	add_child(label)


func _add_bg_and_title(title_text: String) -> void:
	var bg := ColorRect.new()
	bg.color = Color("#f4f7fc")
