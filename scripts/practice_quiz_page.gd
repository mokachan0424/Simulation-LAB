func _build_question() -> void:
	_view_state = "question"
	_built_size = size
	_clear_all()
	answered = false
	_add_bg_and_title(_mode_title())
	var screen_size := size
	var q: Dictionary = questions[current_index]

	var count_label := Label.new()
	count_label.text = "第 %d / %d 問" % [current_index + 1, questions.size()]
	count_label.position = Vector2(0, 82)
	count_label.size = Vector2(screen_size.x, 30)
	count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	count_label.add_theme_font_size_override("font_size", 16)
	count_label.add_theme_color_override("font_color", SUB_COLOR)
	add_child(count_label)

	var panel_w: float = minf(760.0, screen_size.x - 32.0)  # ★v27変更★
	var panel := Panel.new()
	panel.position = Vector2((screen_size.x - panel_w) / 2.0, 118)
	panel.size = Vector2(panel_w, 108)
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color.WHITE
	panel_style.set_corner_radius_all(18)
	panel_style.set_border_width_all(2)
	panel_style.border_color = Color("#94A3B8")
	panel_style.shadow_size = 8  # ★v31追加★ 影で囲いをきれいに
	panel_style.shadow_color = Color(0.12, 0.18, 0.30, 0.10)
	panel_style.shadow_offset = Vector2(0, 3)
	panel.add_theme_stylebox_override("panel", panel_style)
	add_child(panel)

	var q_label := Label.new()
	q_label.text = q["q"]
	# ★v31修正★ ラベルをパネルの大きさにアンカーで合わせる（文字がはみ出さないように）
	q_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	q_label.offset_left = 25
	q_label.offset_top = 15
	q_label.offset_right = -25
	q_label.offset_bottom = -15
	q_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	q_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	q_label.add_theme_font_size_override("font_size", 19)
	q_label.add_theme_color_override("font_color", TEXT_COLOR)
	panel.add_child(q_label)

	var btn_w: float = minf(700.0, screen_size.x - 48.0)  # ★v27変更★
	var btn_x := (screen_size.x - btn_w) / 2.0
	var start_y := 245.0
	if q.get("type", "") == "input":
		# ★v16★ 記述問題: 入力欄と回答ボタン
		answer_edit = LineEdit.new()
		answer_edit.placeholder_text = "ここに答えを入力してね"
		answer_edit.position = Vector2(btn_x, start_y + 10)
		answer_edit.size = Vector2(btn_w, 56)
		answer_edit.add_theme_font_size_override("font_size", 20)
		var edit_style := StyleBoxFlat.new()
		edit_style.bg_color = Color.WHITE
		edit_style.set_corner_radius_all(10)
		edit_style.set_border_width_all(2)
		edit_style.border_color = Color("#cbd5e1")
		edit_style.content_margin_left = 14
		answer_edit.add_theme_stylebox_override("normal", edit_style)
		answer_edit.add_theme_stylebox_override("focus", edit_style)
		add_child(answer_edit)
		answer_edit.grab_focus()
		submit_btn = _make_btn("回答する", Vector2((screen_size.x - 220.0) / 2.0, start_y + 86), Vector2(220, 50), BLUE, Color.WHITE)
		submit_btn.pressed.connect(_on_input_submit)
		add_child(submit_btn)
		answer_edit.text_submitted.connect(func(_t): _on_input_submit())
	else:
		var choices: Array = q["choices"]
		var order: Array = [0, 1, 2, 3]
		order.shuffle()
		for i in 4:
			var original_idx := int(order[i])
			var btn := _make_btn(str(choices[original_idx]), Vector2(btn_x, start_y + i * 68.0), Vector2(btn_w, 56), Color.WHITE, TEXT_COLOR)
			btn.pressed.connect(_on_choice.bind(original_idx, btn))
			add_child(btn)
			choice_buttons.append(btn)

	feedback_label = Label.new()
	feedback_label.position = Vector2(btn_x, 522)
	feedback_label.size = Vector2(btn_w, 40)
	feedback_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	feedback_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
