		next_text = "結果を見る"
	next_btn = _make_btn(next_text, Vector2((screen_size.x - 220.0) / 2.0, 575), Vector2(220, 45), BLUE, Color.WHITE)
	next_btn.visible = false
	next_btn.pressed.connect(_on_next)
	add_child(next_btn)


func _on_choice(original_idx: int, chosen_btn: Button) -> void:
	if answered:
		return
	answered = true
	var q: Dictionary = questions[current_index]
	var correct := original_idx == int(q["answer"])
	if correct:
		score += 1
	if mode == "unit" or mode == "sub" or mode == "review":  # ★v30変更★ 記録するのは通常モードだけ
		_record_answer(int(q["id"]), correct)
	for i in choice_buttons.size():
		var btn: Button = choice_buttons[i]
		btn.disabled = true
	# 正解ボタンを緑、選んだ不正解を赤にする
	var choices: Array = q["choices"]
	for btn in choice_buttons:
		if btn.text == str(choices[int(q["answer"])]):
			_color_btn(btn, GREEN, Color.WHITE)
	if correct:
		feedback_label.text = "⭕ 正解！　" + str(q["exp"])
		feedback_label.add_theme_color_override("font_color", GREEN)
	else:
		_color_btn(chosen_btn, RED, Color.WHITE)
		feedback_label.text = "❌ 不正解。正解は「" + str(choices[int(q["answer"])]) + "」　" + str(q["exp"])
		feedback_label.add_theme_color_override("font_color", RED)
	next_btn.visible = true



# ★v16追加★ 記述問題の回答判定
func _on_input_submit() -> void:
	if answered:
		return
	answered = true
	var q: Dictionary = questions[current_index]
	var input_text := _normalize(answer_edit.text)
	var correct := false
	for a in q["answers"]:
		if input_text == _normalize(str(a)):
			correct = true
			break
	if correct:
		score += 1
	answer_edit.editable = false
	submit_btn.disabled = true
	if correct:
		feedback_label.text = "⭕ 正解！　" + str(q["exp"])
		feedback_label.add_theme_color_override("font_color", GREEN)
	else:
		feedback_label.text = "❌ 不正解。正解は「" + str(q["answers"][0]) + "」　" + str(q["exp"])
		feedback_label.add_theme_color_override("font_color", RED)
	next_btn.visible = true


# 答えの表記ゆれをそろえる (空白を除く・全角英数字を半角に・小文字化)
func _normalize(s: String) -> String:
	var out := ""
	for ch in s:
		if ch == " " or ch == "　" or ch == "\t":
			continue
		var code := ch.unicode_at(0)
		if code >= 0xFF01 and code <= 0xFF5E:
			out += String.chr(code - 0xFEE0)
		else:
			out += ch
	return out.to_lower()


func _on_next() -> void:
	current_index += 1
	if current_index >= questions.size():
		_build_result()
	else:
		_build_question()


func _build_result() -> void:
	_view_state = "result"
	_built_size = size
	timer_active = false
	_clear_all()
	_add_bg_and_title(_mode_title() + "　結果")
	var screen_size := size
	var label := Label.new()
	var message := ""
	var rate := 0.0
	if questions.size() > 0:
		rate = float(score) / float(questions.size()) * 100.0
	if rate >= 80.0:
		message = "すごい！よく理解できています！"
	elif rate >= 50.0:
		message = "よくがんばりました。まちがえた問題は復習で解き直そう！"
	else:
		message = "元素図鑑を見てから、もう一度挑戦しよう！"
	label.text = "%d / %d 問 正解 （%.0f%%）\n\n%s" % [score, questions.size(), rate, message]
	if mode == "mock" or mode == "mock_hard":
		label.text += "\n\n※ 模試の結果はマイページの進捗には保存されません"
	if timed_out:
		label.text += "\n⏱ 時間切れになりました"
	label.position = Vector2(0, 240)
	label.size = Vector2(screen_size.x, 140)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", 22)
	label.add_theme_color_override("font_color", TEXT_COLOR)
	add_child(label)
	var back_btn := _make_btn("マイページへ戻る", Vector2((screen_size.x - 240.0) / 2.0, 420), Vector2(240, 50), BLUE, Color.WHITE)
	back_btn.pressed.connect(func(): queue_free())
	add_child(back_btn)


func _color_btn(btn: Button, bg_color: Color, font_color: Color) -> void:
	var style := StyleBoxFlat.new()
	style.bg_color = bg_color
	style.set_corner_radius_all(14)
	style.set_border_width_all(2)
	style.border_color = Color("#cbd5e1")
	btn.add_theme_stylebox_override("normal", style)
	btn.add_theme_stylebox_override("disabled", style)
	btn.add_theme_color_override("font_color", font_color)
	btn.add_theme_color_override("font_disabled_color", font_color)


func _make_btn(text_value: String, pos: Vector2, btn_size: Vector2, bg_color: Color, font_color: Color) -> Button:
	var btn := Button.new()
	btn.text = text_value
	btn.position = pos
	btn.size = btn_size
	btn.custom_minimum_size = btn_size
	btn.add_theme_font_size_override("font_size", 16)
	btn.add_theme_color_override("font_color", font_color)
	btn.add_theme_color_override("font_hover_color", font_color)
	btn.add_theme_color_override("font_pressed_color", font_color)
	btn.add_theme_color_override("font_focus_color", font_color)
	btn.add_theme_color_override("font_disabled_color", font_color)
	var style := StyleBoxFlat.new()
	style.bg_color = bg_color
	style.set_corner_radius_all(14)
	style.set_border_width_all(2)
	style.border_color = Color("#cbd5e1")
	style.content_margin_left = 14
	style.content_margin_right = 14
	var hover := style.duplicate() as StyleBoxFlat
	hover.bg_color = bg_color.lightened(0.08)
	btn.add_theme_stylebox_override("normal", style)
	btn.add_theme_stylebox_override("hover", hover)
	btn.add_theme_stylebox_override("pressed", style)
	btn.add_theme_stylebox_override("disabled", style)
	return btn


# =====================================
# 成績の保存 (マイページと同じ形式)
# =====================================

func _load_history() -> Dictionary:
	var default_data := {
		"stats": {"total_answers": 0, "correct_answers": 0, "answered_question_ids": []},
		"mistakes": []
	}
	if not FileAccess.file_exists(SAVE_PATH):
		return default_data
	var file := FileAccess.open(SAVE_PATH, FileAccess.READ)
	if file == null:
		return default_data
	var parsed = JSON.parse_string(file.get_as_text())
	file.close()
	if typeof(parsed) != TYPE_DICTIONARY:
		return default_data
	if not parsed.has("stats"):
		parsed["stats"] = default_data["stats"]
	if not parsed.has("mistakes"):
		parsed["mistakes"] = []
	return parsed


func _record_answer(question_id: int, correct: bool) -> void:
	var history := _load_history()
	var stats: Dictionary = history["stats"]
	stats["total_answers"] = int(stats.get("total_answers", 0)) + 1
	if correct:
		stats["correct_answers"] = int(stats.get("correct_answers", 0)) + 1
	var cleared: Array = []
	for v in stats.get("answered_question_ids", []):
		cleared.append(int(v))
	var mistakes: Array = []
	for v in history.get("mistakes", []):
		mistakes.append(int(v))
	if correct:
		if not cleared.has(question_id):
			cleared.append(question_id)
		mistakes.erase(question_id)
	else:
		if not mistakes.has(question_id):
			mistakes.append(question_id)
	stats["answered_question_ids"] = cleared
	history["stats"] = stats
	history["mistakes"] = mistakes
	var file := FileAccess.open(SAVE_PATH, FileAccess.WRITE)
	if file != null:
		file.store_string(JSON.stringify(history))
		file.close()
